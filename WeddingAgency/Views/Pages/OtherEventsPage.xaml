<Page x:Class="WeddingAgency.Views.Pages.OtherEventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WeddingAgency.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OtherEventsPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Организация мероприятий" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Заявка на проведение праздника" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentMainBrush}" Margin="0,0,0,15"/>

                    <TextBlock Text="Тип мероприятия:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboEventTypes" DisplayMemberPath="TypeName" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="Название / Повод:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEventTitle" Margin="0,0,0,12"/>

                    <TextBlock Text="Дата проведения:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DateEvent" Height="36" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Время начала:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtStart" Text="18:00" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Время окончания:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEnd" Text="23:00" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Место проведения (Локация):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtLocation" Margin="0,0,0,12"/>

                    <TextBlock Text="Комментарий (Пожелания):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtComment" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="5" Margin="0,0,0,20"/>

                    <Button Content="Отправить заявку" Click="BtnSubmit_Click" Padding="0,10" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Отзывы наших клиентов" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

            <ListBox x:Name="ListReviews" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,0,15" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Users.FirstName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" Loaded="RatingStars_Loaded">
                                    <TextBlock x:Name="TxtStars" Text="★★★★★" FontSize="14" Foreground="{DynamicResource AccentSecondaryBrush}" FontWeight="Bold"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="{Binding ReviewText}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Grid>
</Page>
