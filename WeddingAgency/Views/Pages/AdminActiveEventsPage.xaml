<Page x:Class="WeddingAgency.Views.Pages.AdminActiveEventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WeddingAgency.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminActiveEventsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Действующие мероприятия в производстве" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

        <!-- ПАНЕЛЬ ФИЛЬТРОВ И ИНСТРУМЕНТОВ -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск по названию или адресу -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Поиск по названию или локации:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSearch" TextChanged="FilterChanged"/>
                </StackPanel>

                <!-- Сортировка по дате проведения -->
                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="Сортировка по дате проведения:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboDateSort" SelectionChanged="FilterChanged" Height="38">
                        <ComboBoxItem Content="Сначала ближайшие даты" IsSelected="True"/>
                        <ComboBoxItem Content="Сначала поздние даты"/>
                    </ComboBox>
                </StackPanel>

                <!-- Кнопка сброса параметров -->
                <Button Grid.Column="2" Content="Сбросить фильтры" Click="BtnResetFilters_Click" Padding="15,0" Height="38" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>
        </Border>

        <!-- ТАБЛИЦА АКТИВНЫХ ЗАКАЗОВ С РАСКРЫВАЮЩИМИСЯ ДЕТАЛЯМИ -->
        <DataGrid x:Name="GridActiveEvents" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                  RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата торжества" Binding="{Binding EventDate, StringFormat={}{0:dd.MM.yyyy}}" Width="130"/>
                <DataGridTextColumn Header="Название праздника" Binding="{Binding Title}" Width="220"/>
                <DataGridTextColumn Header="Повод (Тип)" Binding="{Binding EventTypes.TypeName}" Width="130"/>
                <DataGridTextColumn Header="Локация / Адрес" Binding="{Binding Location}" Width="220"/>
                <DataGridTextColumn Header="Заказчик" Binding="{Binding Users.LastName}" Width="120"/>
                <DataGridTextColumn Header="Бюджет сметы" Binding="{Binding Budget, StringFormat={}{0:N2} руб.}" Width="130"/>
                <DataGridTextColumn Header="Текущий статус" Binding="{Binding EventStatuses.StatusName}" Width="*"/>
            </DataGrid.Columns>

            <!-- ШАБЛОН ПОДРОБНОСТЕЙ ЗАКАЗА (Подгружается автоматически при выборе строки) -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentSecondaryBrush}" BorderThickness="1.5,0,0,0" Padding="20,15" Margin="10,5,10,10">
                        <StackPanel>
                            <TextBlock Text="ПОЛНАЯ СПЕЦИФИКАЦИЯ И ДЕТАЛИЗАЦИЯ СМЕТЫ:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentMainBrush}" Margin="0,0,0,12"/>

                            <!-- Внутренний список элементов сметы текущего заказа -->
                            <ListBox ItemsSource="{Binding EventItems}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Автоматический выбор названия без костылей и конвертеров -->
                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CatalogItems.ItemName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Partners.PartnerName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding HolidayProducts.ProductName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Grid>

                                            <!-- Количество -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Кол-во: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Quantity}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>

                                            <!-- Цена за единицу -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Цена: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding PricePerUnit, StringFormat={}{0:N2} р.}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>

                                            <!-- Итоговая стоимость позиции -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Сумма: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding PricePerUnit, StringFormat={}{0:N2} руб.}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
</Page>
