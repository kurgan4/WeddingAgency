<Page x:Class="WeddingAgency.Views.Pages.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WeddingAgency.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EventsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Все заказы агентства" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,25"/>

        <DataGrid x:Name="GridAllEvents" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="Дата проведения" Binding="{Binding EventDate, StringFormat={}{0:dd.MM.yyyy}}" Width="130"/>
                <DataGridTextColumn Header="Заказчик" Binding="{Binding Users.LastName}" Width="140"/>
                <DataGridTextColumn Header="Бюджет" Binding="{Binding Budget, StringFormat={}{0:N2} руб.}" Width="130"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding EventStatuses.StatusName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
