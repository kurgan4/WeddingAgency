<Page x:Class="WeddingAgency.Views.Pages.TransactionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WeddingAgency.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TransactionsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Финансовый аналитический учет" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,25"/>

        <!-- Сводные карточки (Сколько получили / Сколько заплатили) -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,25" Height="100">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,10,0" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Общий доход (Получено)" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtTotalIncome" Text="0.00 руб." FontSize="20" FontWeight="Bold" Foreground="#2E7D32" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="5,0,5,0" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Выплаты партнерам (Заплатили)" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtTotalExpense" Text="0.00 руб." FontSize="20" FontWeight="Bold" Foreground="#C62828" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="10,0,0,0" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Чистая прибыль агентства" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtNetProfit" Text="0.00 руб." FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Таблица всех кассовых операций -->
        <DataGrid x:Name="GridTransactions" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата операции" Binding="{Binding TransactionDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                <DataGridTextColumn Header="Мероприятие" Binding="{Binding Events.Title}" Width="180"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding TransactionTypes.TypeName}" Width="90"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} руб.}" Width="130"/>
                <DataGridTextColumn Header="Способ оплаты" Binding="{Binding PaymentMethods.MethodName}" Width="120"/>
                <DataGridTextColumn Header="Описание транзакции" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
