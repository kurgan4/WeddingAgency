<Page x:Class="WeddingAgency.Views.Pages.CaptchaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WeddingAgency.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CaptchaPage">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
        <StackPanel>
            <TextBlock Text="Проверка безопасности" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Слишком много неудачных попыток входа. Пожалуйста, введите код с картинки:" 
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,15"/>

            <Border BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="8" Background="#EAEBED" Margin="0,0,0,15">
                <Canvas x:Name="CaptchaCanvas" Height="60" Width="280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Grid Margin="0,0,0,15">
                <TextBox x:Name="captchaInput" Style="{DynamicResource {x:Type TextBox}}"/>
                <TextBlock Text="Введите код сюда" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=captchaInput}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button x:Name="submitCaptcha" Content="Подтвердить" Click="submitCaptcha_Click" Margin="0,0,0,10"/>
            <Button x:Name="refreshCaptcha" Content="Обновить код" Click="refreshCaptcha_Click" Background="{x:Null}" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Page>
