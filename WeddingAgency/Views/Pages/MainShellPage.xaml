<Page x:Class="WeddingAgency.Views.Pages.MainShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WeddingAgency.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainShellPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource CardBackgroundBrush}">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0" MinWidth="140">
                    <TextBlock x:Name="TxtRoleTitle" Text="Роль: Гость" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtUserFullName" Text="Просматривающий" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" Focusable="False" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnWedding" Content="Организация свадьбы" Click="BtnWedding_Click" Margin="0,0,6,0" Padding="10,6"/>
                        <Button x:Name="BtnCatalog" Content="Каталог товаров" Click="BtnCatalog_Click" Margin="0,0,6,0" Padding="10,6"/>
                        <Button x:Name="BtnOtherEvents" Content="Другие мероприятия" Click="BtnOtherEvents_Click" Margin="0,0,6,0" Padding="10,6"/>
                        <Button x:Name="BtnProfile" Content="Профиль" Click="BtnProfile_Click" Margin="0,0,12,0" Padding="10,6"/>

                        <Border x:Name="AdminSeparator" Width="1.5" Height="22" Background="{DynamicResource InputBorderBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <Button x:Name="BtnStats" Content="Статистика" Click="BtnStats_Click" Margin="0,0,6,0" Padding="10,6" Background="{DynamicResource AccentSecondaryBrush}"/>
                        <Button x:Name="BtnManageCatalog" Content="Управление каталогом" Click="BtnManageCatalog_Click" Margin="0,0,6,0" Padding="10,6"/>
                        <Button x:Name="BtnActiveEvents" Content="Действующие заказы" Click="BtnActiveEvents_Click" Margin="0,0,6,0" Padding="10,6"/>
                        <Button x:Name="BtnNewRequests" Content="Прием заявок" Click="BtnNewRequests_Click" Padding="10,6"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="BtnCart" Content="Заказ" Click="BtnCart_Click" Margin="0,0,12,0" Padding="14,6" Background="{DynamicResource AccentMainBrush}" FontWeight="SemiBold"/>

                    <Button x:Name="BtnToggleTheme" Style="{StaticResource ThemeToggleButtonStyle}" Click="BtnToggleTheme_Click" ToolTip="Сменить тему" Margin="0,0,15,0" VerticalAlignment="Center" Width="32" Height="32">
                        <Image Source="{DynamicResource ThemeIconSource}" Width="20" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <Button x:Name="BtnExit" Content="Выйти" Click="BtnExit_Click" Background="{DynamicResource DangerBrush}" Foreground="White" Padding="14,6" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Navigated="ContentFrame_Navigated"/>
    </Grid>
</Page>
