<Page x:Class="WeddingAgency.Views.Pages.AdminStatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WeddingAgency.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminStatsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ПАНЕЛЬ УПРАВЛЕНИЯ -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Финансовая аналитика и статистика" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnExportWord" Content="Экспорт в Word" Click="BtnExportWord_Click" Padding="15,8" Margin="0,0,10,0"/>
                <Button x:Name="BtnExportPdf" Content="Экспорт в PDF" Click="BtnExportPdf_Click" Padding="15,8" Margin="0,0,10,0" Background="{DynamicResource AccentSecondaryBrush}"/>
                <Button x:Name="BtnExportExcel" Content="Экспорт в Excel" Click="BtnExportExcel_Click" Padding="15,8" Background="#1B5E20" Foreground="White"/>
            </StackPanel>
        </Grid>

        <!-- СВОДНЫЕ СЧЕТЧИКИ -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,25" Height="90">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="0,0,10,0" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Валовая выручка (От клиентов)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtTotalIncome" Text="0.00 руб." FontSize="20" FontWeight="Bold" Foreground="#2E7D32" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="5,0,5,0" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Выплаты подрядчикам (85% расходов)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtTotalExpense" Text="0.00 руб." FontSize="20" FontWeight="Bold" Foreground="#C62828" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="10" Margin="10,0,0,0" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Чистый доход агентства (Комиссия 15%)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtNetProfit" Text="0.00 руб." FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ДИАГРАММА: Холст с динамическим перерасчетом размеров по образцу -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="График чистой прибыли по месяцам текущего года" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentMainBrush}" Margin="0,0,0,20"/>

                <!-- Динамический холст для генерации геометрии графика -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1,0,0,1" Margin="30,10,20,30">
                    <Canvas x:Name="ChartCanvas" Background="Transparent" SizeChanged="ChartCanvas_SizeChanged"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
