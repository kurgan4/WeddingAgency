<Page x:Class="WeddingAgency.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WeddingAgency.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UsersPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление пользователями системы" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,25"/>

        <DataGrid x:Name="GridUsers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="130"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="130"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160"/>
                <DataGridTextColumn Header="Роль в системе" Binding="{Binding Roles.RoleName}" Width="130"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding IsActive, Converter={StaticResource BooleanToStatusConverter}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
