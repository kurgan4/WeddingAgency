<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BitmapImage x:Key="ThemeIconSource" UriSource="/res/Icons/moon.png"/>

    <!-- Темные глубокие фоны на основе палитры -->
    <Color x:Key="WindowBackgroundColor">#131B26</Color>
    <Color x:Key="CardBackgroundColor">#193D57</Color>
    <!-- Pantone 534 C -->

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#EAEBED"/>

    <!-- Брендовые акценты (в темноте бирюза горит ярче) -->
    <SolidColorBrush x:Key="AccentMainBrush" Color="#0198AF"/>
    <!-- Pantone 7711 C -->
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#4DC6C5"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#256569"/>

    <!-- Поля ввода и границы -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#233E76"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#256569"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#0198AF"/>

    <!-- Ошибки -->
    <SolidColorBrush x:Key="DangerBrush" Color="#DD4B42"/>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
</ResourceDictionary>