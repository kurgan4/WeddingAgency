<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BitmapImage x:Key="ThemeIconSource" UriSource="/res/Icons/sun.png"/>

    <!-- Основные цвета из брендбука -->
    <Color x:Key="WindowBackgroundColor">#F3F3F3</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#233E76"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9197A3"/>

    <!-- Брендовые акценты -->
    <SolidColorBrush x:Key="AccentMainBrush" Color="#233E76"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#0198AF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#275E9F"/>

    <!-- Поля ввода и границы -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#EAEBED"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#0198AF"/>

    <!-- Ошибки / Предупреждения -->
    <SolidColorBrush x:Key="DangerBrush" Color="#DD4B42"/>

    <!-- Кисти фонов общего назначения -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
</ResourceDictionary>